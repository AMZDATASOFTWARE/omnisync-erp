{
  "name": "ProductPlacement",
  "type": "object",
  "description": "Posi\u00e7\u00e3o f\u00edsica de um produto na loja. Um mesmo SKU pode ter v\u00e1rias posi\u00e7\u00f5es (1:N).",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "sku": {
      "type": "string"
    },
    "zone_id": {
      "type": "string",
      "description": "ID da zona no StoreMap"
    },
    "zone_label": {
      "type": "string"
    },
    "shelf_id": {
      "type": "string",
      "description": "ID da g\u00f4ndola em StoreMap.shelves"
    },
    "shelf_label": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "description": "N\u00edvel da prateleira (1 = mais baixo)"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade alocada nesta posi\u00e7\u00e3o"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Posi\u00e7\u00e3o principal exibida por padr\u00e3o"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "zone_id"
  ]
}