{
  "name": "FiscalEvent",
  "type": "object",
  "description": "Evento fiscal registrado sobre a numera\u00e7\u00e3o ou sobre um documento j\u00e1 emitido (carta de corre\u00e7\u00e3o, inutiliza\u00e7\u00e3o, cancelamento).",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Unidade (Store) emitente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "carta_correcao",
        "inutilizacao",
        "cancelamento"
      ],
      "description": "Tipo do evento fiscal"
    },
    "sale_id": {
      "type": "string",
      "description": "Venda relacionada (CC-e / cancelamento)"
    },
    "chave": {
      "type": "string",
      "description": "Chave de acesso do documento"
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "sequencia": {
      "type": "number",
      "default": 1,
      "description": "Sequ\u00eancia do evento (CC-e incremental por documento)"
    },
    "correcao": {
      "type": "string",
      "description": "Texto da carta de corre\u00e7\u00e3o"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da inutiliza\u00e7\u00e3o ou do cancelamento"
    },
    "serie": {
      "type": "string",
      "description": "S\u00e9rie da numera\u00e7\u00e3o inutilizada"
    },
    "numero_inicial": {
      "type": "number",
      "description": "N\u00famero inicial da faixa inutilizada"
    },
    "numero_final": {
      "type": "number",
      "description": "N\u00famero final da faixa inutilizada"
    },
    "protocolo": {
      "type": "string",
      "description": "Protocolo retornado pelo emissor"
    },
    "status": {
      "type": "string",
      "enum": [
        "registrado",
        "erro"
      ],
      "default": "registrado"
    },
    "error": {
      "type": "string"
    },
    "operador": {
      "type": "string",
      "description": "Usu\u00e1rio que registrou o evento"
    }
  },
  "required": [
    "tipo"
  ]
}