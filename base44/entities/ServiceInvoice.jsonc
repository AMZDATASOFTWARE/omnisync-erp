{
  "name": "ServiceInvoice",
  "type": "object",
  "description": "NFS-e (nota fiscal de servi\u00e7o) emitida pelo Padr\u00e3o Nacional (Sefin Nacional / gov.br).",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Unidade (Store) emitente"
    },
    "tomador_nome": {
      "type": "string"
    },
    "tomador_cpf_cnpj": {
      "type": "string"
    },
    "tomador_email": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "descricao": {
      "type": "string",
      "description": "Discrimina\u00e7\u00e3o do servi\u00e7o prestado"
    },
    "codigo_tributacao_nacional": {
      "type": "string",
      "description": "C\u00f3digo de tributa\u00e7\u00e3o nacional do servi\u00e7o (ex: 01.01.01)"
    },
    "valor_servico": {
      "type": "number"
    },
    "aliquota_iss": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota de ISS em %"
    },
    "valor_iss": {
      "type": "number",
      "default": 0
    },
    "iss_retido": {
      "type": "boolean",
      "default": false
    },
    "municipio_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio de presta\u00e7\u00e3o"
    },
    "competencia": {
      "type": "string",
      "format": "date"
    },
    "ambiente": {
      "type": "string",
      "enum": [
        "producao_restrita",
        "producao"
      ],
      "default": "producao_restrita"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "erro",
        "cancelada"
      ],
      "default": "rascunho"
    },
    "numero": {
      "type": "string"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso da NFS-e (50 d\u00edgitos)"
    },
    "dps_id": {
      "type": "string",
      "description": "Identificador da DPS enviada"
    },
    "danfse_url": {
      "type": "string"
    },
    "error": {
      "type": "string",
      "description": "\u00daltimo erro retornado pela API nacional"
    }
  },
  "required": [
    "descricao",
    "valor_servico"
  ]
}