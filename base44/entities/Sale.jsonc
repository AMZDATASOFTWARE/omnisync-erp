{
  "name": "Sale",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "credito",
        "debito",
        "pix"
      ],
      "default": "dinheiro"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "cash_session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "concluida",
        "cancelada"
      ],
      "default": "concluida"
    },
    "fiscal_status": {
      "type": "string",
      "enum": [
        "pendente",
        "emitida",
        "nao_aplicavel"
      ],
      "default": "pendente",
      "description": "Status da NFC-e"
    },
    "fiscal_number": {
      "type": "string",
      "description": "N\u00famero do documento fiscal emitido"
    },
    "fiscal_key": {
      "type": "string",
      "description": "Chave de acesso (44 d\u00edgitos)"
    },
    "fiscal_error": {
      "type": "string",
      "description": "\u00daltimo erro de emiss\u00e3o"
    }
  },
  "required": [
    "total"
  ]
}