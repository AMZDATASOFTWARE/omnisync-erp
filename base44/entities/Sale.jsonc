{
  "name": "Sale",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Unidade (Store) onde a venda ocorreu"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "credito",
        "debito",
        "pix"
      ],
      "default": "dinheiro"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do destinat\u00e1rio (obrigat\u00f3rio para NF-e modelo 55)"
    },
    "cash_session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "concluida",
        "cancelada"
      ],
      "default": "concluida"
    },
    "fiscal_status": {
      "type": "string",
      "enum": [
        "pendente",
        "emitida",
        "cancelada",
        "nao_aplicavel"
      ],
      "default": "pendente",
      "description": "Status do documento fiscal"
    },
    "fiscal_modelo": {
      "type": "string",
      "enum": [
        "65",
        "55"
      ],
      "default": "65",
      "description": "Modelo do documento fiscal: 65 = NFC-e, 55 = NF-e"
    },
    "fiscal_number": {
      "type": "string",
      "description": "N\u00famero do documento fiscal emitido"
    },
    "fiscal_key": {
      "type": "string",
      "description": "Chave de acesso (44 d\u00edgitos)"
    },
    "fiscal_error": {
      "type": "string",
      "description": "\u00daltimo erro de emiss\u00e3o"
    },
    "fiscal_cancel_reason": {
      "type": "string",
      "description": "Justificativa do cancelamento (m\u00edn. 15 caracteres)"
    },
    "fiscal_canceled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "total"
  ]
}