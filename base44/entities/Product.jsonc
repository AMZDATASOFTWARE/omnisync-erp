{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "sku": {
      "type": "string",
      "description": "C\u00f3digo interno"
    },
    "barcode": {
      "type": "string",
      "description": "C\u00f3digo de barras EAN"
    },
    "category": {
      "type": "string",
      "description": "Categoria do produto"
    },
    "brand": {
      "type": "string",
      "description": "Marca"
    },
    "unit": {
      "type": "string",
      "enum": [
        "un",
        "kg",
        "g",
        "l",
        "ml",
        "m",
        "m2",
        "cx",
        "pct"
      ],
      "default": "un"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda"
    },
    "cost_price": {
      "type": "number",
      "description": "Pre\u00e7o de custo"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque m\u00ednimo para alerta"
    },
    "ncm": {
      "type": "string",
      "description": "C\u00f3digo NCM"
    },
    "cest": {
      "type": "string",
      "description": "C\u00f3digo CEST"
    },
    "lot": {
      "type": "string",
      "description": "Lote"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Validade"
    },
    "map_zone_id": {
      "type": "string",
      "description": "ID da zona no mapa da loja"
    },
    "shelf_label": {
      "type": "string",
      "description": "Prateleira/posi\u00e7\u00e3o dentro da zona"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "price"
  ]
}