{
  "name": "CashSession",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Unidade (Store) do caixa"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechado"
      ],
      "default": "aberto"
    },
    "opening_amount": {
      "type": "number",
      "default": 0
    },
    "closing_amount": {
      "type": "number"
    },
    "expected_amount": {
      "type": "number",
      "description": "Saldo esperado em dinheiro no fechamento (fundo + vendas em dinheiro + refor\u00e7os - sangrias)"
    },
    "difference": {
      "type": "number",
      "description": "Diferen\u00e7a apurada no fechamento (contado - esperado)"
    },
    "divergence_entry_id": {
      "type": "string",
      "description": "FinancialEntry de quebra/sobra de caixa gerado no fechamento"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "operator": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ]
}