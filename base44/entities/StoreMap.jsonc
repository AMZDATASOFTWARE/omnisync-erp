{
  "name": "StoreMap",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Unidade (Store) a que esta planta pertence"
    },
    "name": {
      "type": "string",
      "default": "Loja Principal"
    },
    "cols": {
      "type": "integer",
      "default": 20
    },
    "rows": {
      "type": "integer",
      "default": 12
    },
    "canvas_width": {
      "type": "number",
      "default": 1000,
      "description": "Largura do plano cartogr\u00e1fico"
    },
    "canvas_height": {
      "type": "number",
      "default": 600,
      "description": "Altura do plano cartogr\u00e1fico"
    },
    "grid_step": {
      "type": "number",
      "default": 50,
      "description": "Passo da grade de snap"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "gondola",
              "prateleira",
              "geladeira",
              "caixa",
              "deposito",
              "entrada",
              "corredor",
              "outro"
            ]
          },
          "color": {
            "type": "string"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                }
              }
            }
          },
          "polygon": {
            "type": "array",
            "description": "Pol\u00edgono vetorial (coordenadas normalizadas 0..1)",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "shelves": {
      "type": "array",
      "description": "G\u00f4ndolas/estantes com coordenadas e n\u00edveis",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "zone_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "levels": {
            "type": "integer",
            "default": 1,
            "description": "Quantidade de n\u00edveis de prateleira"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical"
            ],
            "default": "horizontal"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}